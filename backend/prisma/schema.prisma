generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  handle       String   @unique
  displayName  String
  avatarColor   String   @default("#6366f1")
  bio          String   @default("")
  pronouns     String   @default("")
  status       String   @default("Hey there! I'm using ConnectChat.")
  isOnline     Boolean  @default(false)
  theme        String   @default("system")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sentMessages      Message[]      @relation("MessageSender")
  receivedMessages  Message[]      @relation("MessageRecipient")
  memberships       SpaceMember[]  @relation("SpaceMemberUser")
  ownedSpaces       Space[]        @relation("SpaceOwner")
  directChannels    DirectChannel[] @relation("DirectChannelUserA")
  directChannelsB   DirectChannel[] @relation("DirectChannelUserB")
}

model Space {
  id          String @id @default(uuid())
  name        String
  description String @default("")
  emoji       String @default("#")
  ownerId     String
  owner       User   @relation("SpaceOwner", fields: [ownerId], references: [id])
  members     SpaceMember[]
  channels    Channel[]
  createdAt   DateTime @default(now())
}

model SpaceMember {
  id       String @id @default(uuid())
  spaceId  String
  userId   String
  role     String @default("member")
  space    Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user     User   @relation("SpaceMemberUser", fields: [userId], references: [id])
  joinedAt DateTime @default(now())

  @@unique([spaceId, userId])
}

model Channel {
  id        String @id @default(uuid())
  name      String
  spaceId   String
  space     Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime @default(now())
}

model DirectChannel {
  id      String @id @default(uuid())
  userAId String
  userBId String
  userA   User   @relation("DirectChannelUserA", fields: [userAId], references: [id])
  userB   User   @relation("DirectChannelUserB", fields: [userBId], references: [id])
  messages Message[]

  @@unique([userAId, userBId])
}

model Message {
  id              String   @id @default(uuid())
  content         String
  senderId        String
  sender          User     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId     String?
  recipient       User?    @relation("MessageRecipient", fields: [recipientId], references: [id])
  directChannelId String?
  directChannel   DirectChannel? @relation(fields: [directChannelId], references: [id], onDelete: Cascade)
  channelId       String?
  channel        Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([directChannelId, createdAt])
  @@index([channelId, createdAt])
}
